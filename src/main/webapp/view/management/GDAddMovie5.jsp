<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.sql.*,java.util.*,java.time.*,model.*,dao.*,util.Web5" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Cinema5</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><nav>Cinema5 · Bài thực hành &nbsp; <a href="<%=request.getContextPath()%>/index.jsp">Trang chủ</a><a href="<%=request.getContextPath()%>/logout.jsp">Đăng xuất</a></nav><main>
<h1>Thêm thông tin phim</h1><%if("POST".equals(request.getMethod())){try{Web5.post(request);Movie5 m=new Movie5();m.setTenPhim(request.getParameter("TenPhim"));m.setTacGia(request.getParameter("TacGia"));m.setTheLoai(request.getParameter("TheLoai"));m.setThoiLuong(Integer.parseInt(request.getParameter("ThoiLuong")));m.setMoTa(request.getParameter("MoTa"));m.setApPhich(request.getParameter("ApPhich"));String date=request.getParameter("NgayPhatHanh");m.setNgayPhatHanh(date==null||date.isBlank()?null:LocalDate.parse(date));try(Connection c=DAO5.open()){new MovieDAO5(c).saveMovie(m);}session.setAttribute("savedMovie",m);response.sendRedirect("GDAddMovieResult5.jsp");return;}catch(Exception e){%><p class="error">Không lưu được phim: <%=Web5.h(e instanceof SQLIntegrityConstraintViolationException?"Phim đã tồn tại":e.getMessage())%></p><%}}%><% if(session.getAttribute("movieError")!=null){ %><p class="error"><%=Web5.h(session.getAttribute("movieError"))%></p><%session.removeAttribute("movieError");}%><form method="post" action="saveMovie" enctype="multipart/form-data"><input type="hidden" name="csrf" value="<%=Web5.token(session)%>"><label class="field">Tên phim<input name="TenPhim" type="text" required value="<%=Web5.h(request.getParameter("TenPhim"))%>"></label><label class="field">Tác giả<input name="TacGia" type="text" required value="<%=Web5.h(request.getParameter("TacGia"))%>"></label><label class="field">Thể loại<input name="TheLoai" type="text" required value="<%=Web5.h(request.getParameter("TheLoai"))%>"></label><label class="field">Thời lượng (phút)<input name="ThoiLuong" type="number" min="1" required value="<%=Web5.h(request.getParameter("ThoiLuong"))%>"></label><label class="field">Ngày phát hành<input name="NgayPhatHanh" type="date" value="<%=Web5.h(request.getParameter("NgayPhatHanh"))%>"></label><label class="field">Mô tả<input name="MoTa" type="text" value="<%=Web5.h(request.getParameter("MoTa"))%>"></label><label class="field">Áp phích (PNG/JPEG, tối đa 5 MB)<input type="file" name="poster" accept="image/png,image/jpeg"></label><button>Lưu</button> <a href="GDMovieManage5.jsp">Quay lại</a></form>
</main></body></html>