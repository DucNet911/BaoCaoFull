<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.sql.*,java.util.*,java.time.*,model.*,dao.*,util.Web5" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Cinema5</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><nav>Cinema5 · Bài thực hành &nbsp; <a href="<%=request.getContextPath()%>/index.jsp">Trang chủ</a><a href="<%=request.getContextPath()%>/logout.jsp">Đăng xuất</a></nav><main>
<h1>Thanh toán</h1><%Order5 order=null;try{try(Connection c=DAO5.open()){if("POST".equals(request.getMethod())){Web5.post(request);String key=request.getParameter("draft");Ticket5[] ts=(Ticket5[])session.getAttribute("tickets:"+key);if(ts==null)throw new IllegalArgumentException("Phiên chọn vé đã hết hạn");String code=request.getParameter("MaThe");MembershipCard5 card=null;if(code!=null&&!code.isBlank()){card=new MembershipCardDAO5(c).getValidCard(code.trim());Customer5 owner=new MemberDAO5(c).customer(Web5.customer(session).getId());if(owner.getThe()==null||owner.getThe().getId()!=card.getId())throw new IllegalArgumentException("Thẻ không thuộc tài khoản này");}order=new OrderDAO5(c).createOrder(Web5.customer(session),ts,card);session.setAttribute("order:"+order.getId(),order);session.removeAttribute("tickets:"+key);response.sendRedirect("GDPaymentView5.jsp?id="+order.getId());return;}order=(Order5)session.getAttribute("order:"+request.getParameter("id"));if(order==null)throw new IllegalArgumentException("Không tìm thấy đơn đang thanh toán");}}catch(Exception e){%><p class="error"><%=Web5.h(e.getMessage())%></p><a href="GDMovieSelect5.jsp">Chọn lại</a><%}if(order!=null){%><p>Số tiền: <strong><%=order.getTongTien()%> đồng</strong></p><p class="notice">Thanh toán mô phỏng phục vụ bài tập; không thu tiền thật.</p><form method="post" action="GDTicketInvoice5.jsp"><input type="hidden" name="csrf" value="<%=Web5.token(session)%>"><input type="hidden" name="id" value="<%=order.getId()%>"><select name="method"><option value="THE">Thẻ — mô phỏng thành công</option><option value="VI_DIEN_TU">Ví điện tử — mô phỏng thành công</option><option value="THU_THAT_BAI">Mô phỏng thất bại</option></select> <button>Xác nhận trả tiền</button></form><%}%>
</main></body></html>