<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.sql.*,java.util.*,java.time.*,model.*,dao.*,util.Web5" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Cinema5</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><nav>Cinema5 · Bài thực hành &nbsp; <a href="<%=request.getContextPath()%>/index.jsp">Trang chủ</a><a href="<%=request.getContextPath()%>/logout.jsp">Đăng xuất</a></nav><main>
<h1>Vé và hóa đơn</h1><%try{int id=Integer.parseInt(request.getParameter("id"));Order5 order;try(Connection c=DAO5.open()){if("POST".equals(request.getMethod())){Web5.post(request);Order5 draft=(Order5)session.getAttribute("order:"+id);if(draft==null)throw new IllegalArgumentException("Đơn đang thanh toán đã hết phiên");synchronized(session){new Checkout5(c).complete(draft,request.getParameter("method"));session.removeAttribute("order:"+id);}response.sendRedirect("GDTicketInvoice5.jsp?id="+id);return;}order=new OrderDAO5(c).get(id,Web5.customer(session).getId());if(!"DA_THANH_TOAN".equals(order.getTrangThai()))throw new IllegalArgumentException("Đơn chưa hoàn tất");}%><h2>Hóa đơn <%=Web5.h(order.getMaHoaDon())%></h2><p>Ngày lập: <%=order.getNgayLap()%></p><p>Khách hàng: <%=Web5.h(order.getThanhVien().getHoVaTen())%></p><table><tr><th>Mã vé</th><th>Phim</th><th>Suất chiếu</th><th>Ghế</th><th>Giá</th></tr><%for(Ticket5 t:order.getVe()){%><tr><td><%=Web5.h(t.getMaVe())%></td><td><%=Web5.h(t.getSuatChieu().getPhim().getTenPhim())%></td><td><%=t.getSuatChieu().getGioBatDau()%></td><td><%=Web5.h(t.getGhe().getMaGhe())%></td><td><%=t.getGia()%></td></tr><%}%></table><strong>Tổng tiền: <%=order.getTongTien()%> đồng</strong><p><button onclick="window.print()">In vé và hóa đơn</button> <a class="button" href="GDCustomerHome5.jsp">Hoàn tất</a></p><%}catch(Exception e){%><p class="error"><%=Web5.h(e.getMessage())%></p><a href="GDPaymentView5.jsp?id=<%=Web5.h(request.getParameter("id"))%>">Thử thanh toán lại</a> · <a href="GDMovieSelect5.jsp">Chọn ghế khác</a><%}%>
</main></body></html>