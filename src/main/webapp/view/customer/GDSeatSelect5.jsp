<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.sql.*,java.util.*,java.time.*,model.*,dao.*,util.Web5" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Cinema5</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><nav>Cinema5 · Bài thực hành &nbsp; <a href="<%=request.getContextPath()%>/index.jsp">Trang chủ</a><a href="<%=request.getContextPath()%>/logout.jsp">Đăng xuất</a></nav><main>
<h1>Chọn ghế</h1><%try(Connection c=DAO5.open()){Screening5 s=new ScreeningDAO5(c).get(Integer.parseInt(request.getParameter("screening")));Set<Integer> booked=new HashSet<>();for(Ticket5 t:new TicketDAO5(c).getBookedTickets(s))booked.add(t.getGhe().getId());%><p><%=Web5.h(s.getPhim().getTenPhim())%> · <%=s.getGioBatDau()%></p><p>Thường: 50.000đ · VIP: 75.000đ. Ghế bị khóa đã được bán.</p><form method="post" action="GDTicketConfirm5.jsp"><input type="hidden" name="csrf" value="<%=Web5.token(session)%>"><input type="hidden" name="screening" value="<%=s.getId()%>"><%for(Seat5 g:new SeatDAO5(c).getSeats(s)){%><label class="seat"><input type="checkbox" name="seat" value="<%=g.getId()%>" <%=booked.contains(g.getId())?"disabled":""%>><%=Web5.h(g.getMaGhe())%> (<%=Web5.h(g.getLoaiGhe())%>)</label><%}%><p><button>Xác nhận</button></p></form><%}%>
</main></body></html>