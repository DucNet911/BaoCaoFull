<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.sql.*,java.util.*,java.time.*,model.*,dao.*,util.Web5" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Cinema5</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><nav>Cinema5 · Bài thực hành &nbsp; <a href="<%=request.getContextPath()%>/index.jsp">Trang chủ</a><a href="<%=request.getContextPath()%>/logout.jsp">Đăng xuất</a></nav><main>
<h1>Xác nhận thông tin vé</h1><%try{Web5.post(request);try(Connection c=DAO5.open()){Screening5 s=new ScreeningDAO5(c).get(Integer.parseInt(request.getParameter("screening")));String[] ids=request.getParameterValues("seat");if(ids==null)throw new IllegalArgumentException("Bạn chưa chọn ghế");Seat5[] gs=new Seat5[ids.length];for(int i=0;i<ids.length;i++){gs[i]=new Seat5();gs[i].setId(Integer.parseInt(ids[i]));}Ticket5[] ts=new TicketDAO5(c).prepareTickets(s,gs);String draftKey=UUID.randomUUID().toString();session.setAttribute("tickets:"+draftKey,ts);%><p><%=Web5.h(s.getPhim().getTenPhim())%> · <%=s.getGioBatDau()%></p><ul><%for(Ticket5 t:ts){%><li><%=Web5.h(t.getGhe().getMaGhe())%> — <%=t.getGia()%> đồng</li><%}%></ul><form method="post" action="GDPaymentView5.jsp"><input type="hidden" name="csrf" value="<%=Web5.token(session)%>"><input type="hidden" name="draft" value="<%=draftKey%>"><label class="field">Mã thẻ thành viên (không bắt buộc)<input name="MaThe"></label><button>Thanh toán</button></form><%}}catch(Exception e){%><p class="error"><%=Web5.h(e.getMessage())%></p><a href="GDMovieSelect5.jsp">Chọn lại</a><%}%>
</main></body></html>